generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum RequirementType {
  FUNCTIONAL
  NON_FUNCTIONAL
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RequirementStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
}

enum ExecutionResult {
  PASSED
  FAILED
  BLOCKED
  NOT_EXECUTED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DefectStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TestCaseStatus {
  DRAFT
  READY
  DEPRECATED
}

enum TestCycleStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  projects     Project[]
}

model Project {
  id           String        @id @default(cuid())
  userId       String
  name         String
  description  String?
  objective    String?
  status       ProjectStatus @default(ACTIVE)
  reqCounter   Int           @default(0)
  tcCounter    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id])
  requirements Requirement[]
  testCases    TestCase[]
  testCycles   TestCycle[]
  testPaths    TestPath[]
  defects      Defect[]

  @@index([userId])
}

model Requirement {
  id          String              @id @default(cuid())
  projectId   String
  code        String
  title       String
  description String
  type        RequirementType
  priority    Priority            @default(MEDIUM)
  status      RequirementStatus   @default(DRAFT)
  source      String?
  deletedAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  project     Project             @relation(fields: [projectId], references: [id])
  criteria    AcceptanceCriterion[]
  testCases   TestCase[]
  history     RequirementHistory[]

  @@unique([projectId, code])
}

model RequirementHistory {
  id            String      @id @default(cuid())
  requirementId String
  field         String
  oldValue      String?
  newValue      String?
  changedAt     DateTime    @default(now())
  requirement   Requirement @relation(fields: [requirementId], references: [id])
}

model AcceptanceCriterion {
  id            String      @id @default(cuid())
  requirementId String
  text          String
  approved      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  requirement   Requirement @relation(fields: [requirementId], references: [id])
  testCases     TestCase[]
}

model TestCase {
  id            String          @id @default(cuid())
  projectId     String
  requirementId String?
  code          String
  title         String
  objective     String?
  preconditions String?
  testData      String?
  steps         String
  expected      String
  type          String          @default("functional")
  priority      Priority        @default(MEDIUM)
  status        TestCaseStatus  @default(READY)
  module        String?
  deletedAt     DateTime?
  automationSteps Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  project       Project         @relation(fields: [projectId], references: [id])
  requirement   Requirement?    @relation(fields: [requirementId], references: [id])
  criteria      AcceptanceCriterion[]
  executions    TestExecution[]
  cycleLinks    TestCycleCase[]
  pathSteps     TestPathStep[]
  defects       Defect[]

  @@unique([projectId, code])
  @@index([projectId, status])
}

model TestCycle {
  id         String          @id @default(cuid())
  projectId  String
  name       String
  goal       String?
  status     TestCycleStatus @default(PLANNED)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCases  TestCycleCase[]
  executions TestExecution[]

  @@index([projectId, status])
}

model TestCycleCase {
  id         String    @id @default(cuid())
  cycleId    String
  testCaseId String
  addedAt    DateTime  @default(now())
  cycle      TestCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  testCase   TestCase  @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([cycleId, testCaseId])
}

model TestPath {
  id          String         @id @default(cuid())
  projectId   String
  name        String
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steps       TestPathStep[]

  @@index([projectId])
}

model TestPathStep {
  id         String   @id @default(cuid())
  pathId     String
  testCaseId String
  position   Int
  note       String?
  path       TestPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([pathId, position])
  @@index([testCaseId])
}

model TestExecution {
  id         String          @id @default(cuid())
  testCaseId String
  cycleId    String?
  result     ExecutionResult @default(NOT_EXECUTED)
  executor   String?
  notes      String?
  evidence   String?
  targetUrl  String?
  durationMs Int?
  stepResults Json?
  failureMessage String?
  executedAt DateTime        @default(now())
  testCase   TestCase        @relation(fields: [testCaseId], references: [id])
  cycle      TestCycle?      @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  defects    Defect[]

  @@index([cycleId, executedAt])
}

model Defect {
  id               String         @id @default(cuid())
  projectId        String?
  testCaseId       String?
  executionId      String?
  title            String
  description      String
  severity         Severity       @default(MEDIUM)
  status           DefectStatus   @default(OPEN)
  actualResult     String?
  expectedResult  String?
  stepsToReproduce String?
  environment      String?
  assignee         String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  project          Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCase         TestCase?      @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  execution        TestExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)

  @@index([projectId, status, severity])
}
